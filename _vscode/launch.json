{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Server",
            "request": "launch",
            "mainClass": "com.thriftbite.server.ServerMain",
            "projectName": "thriftbite-sockets",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "Client 1",
            "request": "launch",
            "mainClass": "com.thriftbite.MVC.view.client.client1",
            "projectName": "thriftbite-sockets",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "Client 2",
            "request": "launch",
            "mainClass": "com.thriftbite.MVC.view.client.client2",
            "projectName": "thriftbite-sockets",
            "cwd": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Server + 2 Clients",
            "configurations": ["Server", "Client 1", "Client 2"],
            "stopAll": true
        }
    ]
}
