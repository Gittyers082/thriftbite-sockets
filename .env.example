# Copy this file to .env and fill in real values. Never commit .env.
# Locally you don't need any of these: the backend uses backend/compose.yaml.

# --- Backend (production, e.g. Render) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<db-password>
# Key for signing login tokens: a long random string, at least 32 characters.
# Generate one with: openssl rand -base64 48
APP_JWT_SECRET=<long-random-secret>
# First admin account, created on startup if it doesn't exist (password: 12+ characters)
APP_ADMIN_USERNAME=<admin-username>
APP_ADMIN_PASSWORD=<admin-password>
# Frontend origin allowed to call the API (CORS)
APP_CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app

# --- Frontend (Vite, build time) ---
VITE_API_URL=https://<your-backend>.onrender.com

# Header the host's proxy puts the real client address in, for rate limiting.
# Leave empty locally. Only set it when the app can't be reached except through that proxy.
APP_CLIENT_IP_HEADER=
